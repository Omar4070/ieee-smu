---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackgroundWaves from '../components/BackgroundWaves.astro';
import PowerOn from '../components/PowerOn.astro';
import WaveChange from '../components/WaveChange.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import TextMotion from '../components/TextMotion.astro';
import Magnet from '../components/Magnet.astro';
import { site } from '../config/site';
import { url } from '../lib/utils';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';

interface Props {
  /** Page title; the chapter name is appended automatically. */
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description = site.description, image, type = 'website', noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.university}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url('/og-default.png'), Astro.site);
// The power-on opening plays on the home page only, so visitors landing on an inner page can read at once.
const isHome = Astro.url.pathname.replace(/index\.html$/, '') === url('/');
---
<!doctype html>
<html lang="en" data-home={isHome ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    {isHome && <link rel="preload" href={url(site.logoWhite)} as="image" />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#00629b" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme before first paint, so dark-mode visitors never see a white flash. -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.dataset.theme = theme;
        // Arriving through the wave page change: the colours already cover this page and lift away.
        // Power-on opening: home page, first page of a visit only, never with reduced motion.
        try {
          if (sessionStorage.getItem('wave')) {
            sessionStorage.removeItem('wave');
            sessionStorage.setItem('powered', '1');
            d.classList.add('wave-in');
          }
          if (d.hasAttribute('data-home') && !sessionStorage.getItem('powered') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            d.classList.add('intro');
            sessionStorage.setItem('powered', '1');
          }
        } catch {}
      })();
    </script>
  </head>
  <body class="flex min-h-svh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    {isHome && <PowerOn />}
    <WaveChange />
    <SmoothScroll />
    <!-- Splits the headings before the page's own scripts and the reveal script below run. -->
    <TextMotion />
    <Magnet />
    <BackgroundWaves />
    <Header />
    <!-- overflow-x: clip: photos settling from a zoom (photo-reveal) may not widen the page.
         Clip, not hidden, so sticky sections still stick and no scroll box is created. -->
    <main id="main" tabindex="-1" class="flex-1 overflow-x-clip focus:outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // Section parts enter once as they scroll into view. Without JS, or with
      // reduced motion, everything is simply visible.
      // Long-form content (Markdown) enters paragraph by paragraph.
      document.querySelectorAll('[data-reveal-children] > *').forEach((el, i) => {
        el.setAttribute('data-reveal', '');
        (el as HTMLElement).style.setProperty('--i', String(Math.min(i, 3)));
      });
      // Click surge: three rings in the society colours expand from every click.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        addEventListener(
          'pointerdown',
          (e) => {
            if (e.button !== 0) return;
            const s = document.createElement('span');
            s.className = 'surge';
            s.setAttribute('aria-hidden', 'true');
            s.style.left = `${e.clientX}px`;
            s.style.top = `${e.clientY}px`;
            s.innerHTML = '<i></i><i></i><i></i>';
            document.body.appendChild(s);
            setTimeout(() => s.remove(), 1100);
          },
          { passive: true },
        );
      }

      // Photographs lean gently towards the pointer (mouse only, motion allowed).
      if (matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
          el.style.transition = 'transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1)';
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            el.style.transform = `perspective(900px) rotateX(${(-y * 7).toFixed(2)}deg) rotateY(${(x * 7).toFixed(2)}deg)`;
          });
          el.addEventListener('pointerleave', () => (el.style.transform = ''));
        });
      }

      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reveal = (el: HTMLElement) => {
        el.dataset.reveal = 'in';
        const done = () => (el.dataset.reveal = 'done');
        el.addEventListener('transitionend', done, { once: true });
        setTimeout(done, 1600);
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target as HTMLElement);
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach(reveal);
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 8px;
    top: -100px;
    z-index: 100;
    padding: 12px 16px;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 500;
    text-decoration: none;
  }
  .skip-link:focus { top: 8px; }

  /* Click surge rings (see the script above). */
  .surge { position: fixed; z-index: 300; width: 0; height: 0; pointer-events: none; }
  .surge i {
    position: absolute;
    left: -22px;
    top: -22px;
    width: 44px;
    height: 44px;
    border: 3px solid #3ccf6b;
    border-radius: 50%;
    opacity: 0;
    animation: surge 760ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  .surge i:nth-child(2) { border-color: #ff8a3d; animation-delay: 90ms; }
  .surge i:nth-child(3) { border-color: #4f8fe0; animation-delay: 180ms; }
  @keyframes surge {
    0% { transform: scale(0.2); opacity: 1; }
    100% { transform: scale(3.6); opacity: 0; }
  }
</style>
