---
/**
 * The close: the page's colours flipped (ink becomes the ground), the idea
 * returns as a headline, one sentence and one button.
 */
import { url } from '../lib/utils';
import Arrow from './Arrow.astro';
import MagnetField from './MagnetField.astro';
import VariableProximity from './VariableProximity.astro';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  action?: string;
  /** The home page's wire ends at this button, so there it must not lean towards the pointer. */
  wired?: boolean;
}
const {
  title = 'Join the current',
  text = 'Student membership adds the magazines, awards and worldwide network of three IEEE societies to everything we run here.',
  href = '/join/',
  action = 'How to join',
  wired = false,
} = Astro.props;
---
<section class="cta field-ink" aria-labelledby="cta-title">
  <MagnetField />
  <div class="wrap cta-inner">
    <h2 id="cta-title" class="cta-title" data-reveal data-proximity>{title}</h2>
    <div class="cta-foot">
      <p class="cta-text" data-reveal style="--i: 1">{text}</p>
      <a href={url(href)} class="btn cta-btn" data-reveal data-magnet={wired ? undefined : ''} style="--i: 2">
        {action} <Arrow size={20} />
      </a>
    </div>
  </div>
</section>
<VariableProximity />

<style>
  /* pan-y: a finger dragging sideways moves the magnet, while dragging up and down still scrolls the page. */
  .cta { position: relative; overflow: hidden; touch-action: pan-y; }
  /* Two columns on the grid: the headline on the left, the sentence and the button closing it on the right. */
  .cta-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px 24px;
    align-items: end;
    padding-block: clamp(72px, 9vw, 128px);
  }
  .cta-title {
    grid-column: 1 / span 6;
    max-width: 11ch;
    font-size: clamp(34px, 4.4vw, 64px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .cta-foot {
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .cta-text { max-width: 40ch; font-size: 18px; }
  .cta-btn { min-height: 56px; }
  /* In dark theme the inverted field is light, the button stays IEEE blue. */

  @media (max-width: 899px) {
    .cta-title, .cta-foot { grid-column: 1 / -1; }
  }
  @media (max-width: 639px) {
    .cta-title { font-size: 10vw; }
    .cta-text { font-size: 17px; }
    .cta-btn { width: 100%; }
  }
</style>
