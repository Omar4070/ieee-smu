---
/**
 * The close: the page's colours flipped (ink becomes the ground), the idea
 * returns as a headline, one sentence and one button.
 */
import { url } from '../lib/utils';
import Arrow from './Arrow.astro';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  action?: string;
}
const {
  title = 'Join the current',
  text = 'Student membership adds the magazines, awards and worldwide network of three IEEE societies to everything we run here.',
  href = '/join/',
  action = 'How to join',
} = Astro.props;
---
<section class="cta field-ink" aria-labelledby="cta-title">
  <div class="wrap cta-inner">
    <h2 id="cta-title" class="cta-title" data-reveal>{title}</h2>
    <div class="cta-foot">
      <p class="cta-text" data-reveal style="--i: 1">{text}</p>
      <a href={url(href)} class="btn cta-btn" data-reveal style="--i: 2">
        {action} <Arrow size={20} />
      </a>
    </div>
  </div>
</section>

<style>
  .cta { min-height: 90svh; display: flex; }
  .cta-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
    padding-top: clamp(80px, 14svh, 160px);
    padding-bottom: 40px;
  }
  .cta-title {
    max-width: 11ch;
    font-size: clamp(56px, 10vw, 144px);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .cta-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
  }
  .cta-text { max-width: 40ch; font-size: 20px; }
  .cta-btn { min-height: 56px; }
  /* In dark theme the inverted field is light, the button stays IEEE blue. */

  @media (max-width: 639px) {
    .cta { min-height: 80svh; }
    .cta-title { font-size: 15vw; }
    .cta-text { font-size: 17px; }
    .cta-btn { width: 100%; }
  }
</style>
