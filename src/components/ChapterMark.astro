---
/**
 * The chapter mark: the three-colour wave from the chapter logo, one trough
 * per society (IAS green, IES orange, PES blue). Drawn in SVG so it stays
 * sharp at header size; the full logo is used where there is room.
 */
interface Props {
  width?: number;
  class?: string;
  /** Use lighter strokes so the PES blue stays visible on black. */
  onDark?: boolean;
}
const { width = 44, class: className, onDark = false } = Astro.props;
const segment = (x: number) => `M${x} 4C${x + 5} 4 ${x + 5} 20 ${x + 8} 20C${x + 11} 20 ${x + 11} 4 ${x + 16} 4`;
const colours = onDark ? ['#2fae55', '#ff7a2f', '#5b8fd6'] : ['#0a792d', '#ed5703', '#093f7a'];
---
<svg
  class={className}
  width={width}
  height={width / 2}
  viewBox="-2 0 52 24"
  fill="none"
  stroke-width="3.5"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  {colours.map((c, i) => <path d={segment(i * 16)} stroke={c} />)}
</svg>
