---
/**
 * The built-in chapter mark: three bars in the society colours, in power-chain
 * order (PES, IES, IAS). Replaced by the real logo when `site.logo` is set.
 */
import { site } from '../config/site';
import { url } from '../lib/utils';

interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---
{
  site.logo ? (
    <img src={url(site.logo)} alt="" width={size} height={size} class={className} />
  ) : (
    <svg class={className} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <rect x="2" y="6" width="8" height="24" fill="#78BE20" />
      <rect x="12" y="2" width="8" height="28" fill="#00B5E2" />
      <rect x="22" y="10" width="8" height="20" fill="#FFC72C" />
    </svg>
  )
}
