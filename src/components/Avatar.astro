---
/**
 * A member's portrait, or their initials on their society's colour when no
 * photo has been added yet.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fieldFor } from '../lib/utils';

interface Props {
  name: string;
  photo?: ImageMetadata;
  society?: string;
  size?: number;
}
const { name, photo, society, size = 96 } = Astro.props;
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('');
---
{
  photo ? (
    <Image src={photo} alt="" width={size * 2} height={size * 2} class="avatar" style={`width:${size}px;height:${size}px`} />
  ) : (
    <span class={`avatar avatar-initials ${fieldFor(society)}`} style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px`} aria-hidden="true">
      {initials}
    </span>
  )
}

<style>
  .avatar {
    flex: none;
    border-radius: 9999px;
    object-fit: cover;
  }
  .avatar-initials {
    display: inline-grid;
    place-items: center;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
</style>
