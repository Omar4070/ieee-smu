---
/**
 * Photograph with two figure tiles. Years active is the heading itself, so the
 * mosaic keeps exactly two tiles.
 */
import { Image } from 'astro:assets';
import { site } from '../../config/site';
import linesDusk from '../../assets/found/pes-lines-dusk.jpg';

const years = new Date().getFullYear() - site.founded;
---
<section class="section bg-canvas" aria-labelledby="stats-title">
  <div class="wrap">
    <h2 id="stats-title" class="t-headline mb-10" data-reveal>
      {years} years active, since {site.founded}
    </h2>
  </div>
  <div class="mosaic">
    <div class="photo" data-reveal>
      <Image
        src={linesDusk}
        alt="High-voltage transmission lines crossing fields at dusk"
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 768px) 66vw, 100vw"
        class="photo-img"
      />
    </div>
    <div class="figure field-ias" data-reveal style="--i: 1">
      <p class="figure-num tabular-nums" data-count={site.stats.members}>{site.stats.members}</p>
      <p class="figure-cap">student members across the three societies</p>
    </div>
    <div class="figure field-black" data-reveal style="--i: 2">
      <p class="figure-num tabular-nums" data-count={site.stats.eventsPerYear}>{site.stats.eventsPerYear}</p>
      <p class="figure-cap">workshops, visits and competitions last year</p>
    </div>
  </div>
</section>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    height: min(66vw, 880px);
  }
  .photo { grid-row: span 2; overflow: hidden; }
  .photo :global(.photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: drift 24s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from { transform: scale(1.02) translateX(0); }
    to { transform: scale(1.08) translateX(-1.5%); }
  }
  .figure { padding: 28px; }
  .figure-num {
    font-size: clamp(56px, 10vw, 144px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .figure-cap { max-width: 22ch; margin-top: 16px; font-size: 20px; line-height: 1.35; }

  @media (max-width: 767px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      height: auto;
    }
    .photo { grid-column: span 2; grid-row: auto; aspect-ratio: 4 / 3; }
    .figure { aspect-ratio: 1; padding: 20px; }
    .figure-num { font-size: 15vw; }
    .figure-cap { font-size: 15px; }
  }
</style>

<script>
  // Figures count up from zero the first time they scroll into view.
  const figures = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.count);
          const start = performance.now();
          const step = (now: number) => {
            const t = Math.min(1, (now - start) / 1400);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
          io.unobserve(el);
        }
      },
      { threshold: 0.6 },
    );
    figures.forEach((el) => io.observe(el));
  }
</script>
