---
/**
 * Home hero. The chapter logo's wave becomes a live three-phase current: one
 * sine per society, 120° apart, flowing across the screen. Below it, a stack
 * of file folders (one per society, then events); pointing at a society's
 * folder brings its phase forward. The front folder is the chapter itself.
 */
import { site } from '../../config/site';
import { societies } from '../../config/societies';
import { formatDate, getEvents, url } from '../../lib/utils';
import Arrow from '../Arrow.astro';

const { upcoming } = await getEvents();
const next = upcoming[0];

// Three-phase waveform, sampled at build time. One wavelength is 400 units;
// paths run one extra wavelength so the flow animation can loop seamlessly.
const wavelength = 400;
const amplitude = 46;
const mid = 60;
const phasePath = (phaseDeg: number) => {
  const points: string[] = [];
  for (let x = 0; x <= 1200 + wavelength; x += 6) {
    const y = mid - amplitude * Math.sin((2 * Math.PI * x) / wavelength - (phaseDeg * Math.PI) / 180);
    points.push(`${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`);
  }
  return points.join('');
};
const phases = societies.map((s, i) => ({ key: s.field, id: s.id, d: phasePath(i * 120) }));

const folders = [
  ...societies.map((s) => ({
    key: s.field,
    tab: s.id,
    href: url(`/about/#${s.id.toLowerCase()}`),
    title: s.name,
    detail: s.role,
  })),
  {
    key: 'blue',
    tab: 'Events',
    href: next ? url(`/events/${next.id}/`) : url('/events/'),
    title: next ? `Next: ${next.data.title}` : 'Events',
    detail: next ? formatDate(next.data.date) : 'See past events',
  },
];
---
<section class="hero bg-canvas" aria-labelledby="hero-title">
  <div class="wrap hero-head">
    <h1 id="hero-title" class="hero-title" translate="no" data-reveal>
      IAS<span aria-hidden="true">&thinsp;·&thinsp;</span><span class="sr-only">, </span>IES<span aria-hidden="true">&thinsp;·&thinsp;</span><span class="sr-only"> and </span>PES
    </h1>
    <p class="hero-sub" data-reveal style="--i: 1">
      The IEEE Industry Applications, Industrial Electronics and Power &amp; Energy societies joint chapter of the{' '}
      {site.studentBranch}.
    </p>
  </div>

  <svg class="wave" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <g class="flow">
      {phases.map((p) => <path class={`phase phase-${p.key}`} d={p.d} />)}
    </g>
  </svg>

  <nav class="folders" aria-label="Explore the chapter">
    {
      folders.map((f, i) => (
        <a href={f.href} class={`folder field-${f.key}`} style={`--n: ${i}`}>
          <span class="tab tab-shape" aria-hidden="true">{f.tab}</span>
          <span class="strip">
            <span class="strip-text">
              <span class="strip-title">{f.title}</span>
              <span class="strip-detail">{f.detail}</span>
            </span>
            <Arrow size={22} class="strip-arrow" />
          </span>
        </a>
      ))
    }
    <div class="folder front field-black" style="--n: 4">
      <span class="tab tab-shape front-tab" aria-hidden="true">The chapter</span>
      <div class="front-body">
        <img
          src={url(site.logoWhite)}
          alt={`IEEE IAS, IES and PES logos: ${site.studentBranch} Joint Chapter`}
          width="1248"
          height="495"
          class="front-logo"
          fetchpriority="high"
        />
        <div class="front-action">
          <a href={url('/join/')} class="btn">
            Join the chapter <Arrow size={20} />
          </a>
          <p class="front-note">Open to every IEEE student member at {site.university}.</p>
        </div>
      </div>
    </div>
  </nav>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
  }
  .hero-head {
    padding-top: clamp(40px, 7svh, 80px);
    text-align: center;
  }
  .hero-title {
    font-size: clamp(44px, 10vw, 144px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .hero-sub {
    max-width: 46ch;
    margin: clamp(20px, 3svh, 32px) auto 0;
    font-size: 20px;
    line-height: 1.5;
  }

  /* ----- Three-phase waveform ----- */
  .wave {
    display: block;
    width: 100%;
    height: clamp(72px, 12svh, 120px);
    margin-top: clamp(16px, 3svh, 32px);
    overflow: visible;
  }
  .phase {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    transition: opacity 240ms ease, stroke-width 240ms ease;
  }
  .phase-ias { stroke: var(--ias); }
  .phase-ies { stroke: var(--ies); }
  .phase-pes { stroke: var(--pes); }
  /* PES blue and IAS green are too dark on the dark theme's canvas: lift the lines only. */
  :global([data-theme='dark']) .phase-pes { stroke: #5b8fd6; }
  :global([data-theme='dark']) .phase-ias { stroke: #2fae55; }

  @media (prefers-reduced-motion: no-preference) {
    .flow { animation: flow 7s linear infinite; }
  }
  @keyframes flow {
    to { transform: translateX(-400px); }
  }

  /* Pointing at a society's folder brings its phase forward. */
  .hero:has(.folder.field-ias:is(:hover, :focus-visible)) .phase:not(.phase-ias),
  .hero:has(.folder.field-ies:is(:hover, :focus-visible)) .phase:not(.phase-ies),
  .hero:has(.folder.field-pes:is(:hover, :focus-visible)) .phase:not(.phase-pes) {
    opacity: 0.15;
  }
  .hero:has(.folder.field-ias:is(:hover, :focus-visible)) .phase-ias,
  .hero:has(.folder.field-ies:is(:hover, :focus-visible)) .phase-ies,
  .hero:has(.folder.field-pes:is(:hover, :focus-visible)) .phase-pes {
    stroke-width: 7;
  }

  /* ----- Folder stack ----- */
  .folders {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: min(86%, 1320px);
    margin-inline: auto;
    padding-top: 56px; /* room for the first tab */
  }
  .folder {
    position: relative;
    z-index: calc(var(--n) + 1);
    display: block;
    text-decoration: none;
    transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
    animation: folder-rise 720ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(200ms + var(--n) * 90ms);
  }
  @keyframes folder-rise {
    from { transform: translateY(48px); }
  }
  a.folder:hover,
  a.folder:focus-visible {
    transform: translateY(-10px);
  }
  a.folder:focus-visible {
    outline-offset: -3px;
  }

  .tab {
    position: absolute;
    bottom: 100%;
    left: var(--tab-x);
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 168px;
    height: 40px;
    padding: 0 28px;
    background: inherit;
    font-size: 17px;
    font-weight: 500;
    white-space: nowrap;
  }
  .strip {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    min-height: 64px;
    padding: 0 24px;
  }
  .strip-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 16px;
    min-width: 0;
  }
  .strip-title {
    font-size: 17px;
    font-weight: 600;
  }
  .strip-detail {
    font-size: 17px;
  }
  .folder :global(.strip-arrow) {
    flex: none;
    transition: transform 240ms ease;
  }
  a.folder:hover :global(.strip-arrow) {
    transform: translateX(6px);
  }

  .front {
    flex: 1;
    min-height: 168px;
  }
  /* Each tab sits beside, not over, the text on the strip in front of it. */
  .folder:nth-of-type(1) { --tab-x: 0%; }
  .folder:nth-of-type(2) { --tab-x: 44%; }
  .folder:nth-of-type(3) { --tab-x: 58%; }
  .folder:nth-of-type(4) { --tab-x: 72%; }
  .front-tab {
    left: auto;
    right: 0;
  }
  .front-body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding: 28px 32px 40px;
  }
  .front-logo {
    width: min(360px, 100%);
    height: auto;
  }
  .front-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .front-note {
    font-size: 17px;
    max-width: 30ch;
  }

  @media (max-width: 767px) {
    .hero-head {
      padding-top: 48px;
    }
    .hero-title {
      font-size: min(13vw, 64px);
    }
    .hero-sub {
      font-size: 17px;
    }
    .front-body {
      padding: 24px var(--gutter) 32px;
    }
    .front-action,
    .front-action .btn {
      width: 100%;
    }
    .front-logo {
      width: min(300px, 100%);
    }
  }

  /* Below desktop the next tab would cover the strip's text: stagger the tabs
     left, centre, right and keep a clear band at the bottom of each strip. */
  @media (max-width: 1099px) {
    .folders {
      width: 100%;
      padding-top: 40px;
    }
    .tab {
      height: 32px;
      min-width: 112px;
      padding: 0 20px;
      font-size: 15px;
    }
    .folder:nth-of-type(3n + 1) .tab { left: 0; }
    .folder:nth-of-type(3n + 2) .tab { left: calc(50% - 56px); }
    .folder:nth-of-type(3n + 3) .tab { left: auto; right: 0; }
    .strip {
      align-items: flex-start;
      min-height: 0;
      padding: 10px var(--gutter) 42px;
    }
    .strip-text {
      flex-direction: column;
      row-gap: 0;
    }
    .strip-title {
      font-size: 16px;
      line-height: 1.3;
    }
    .strip-detail {
      font-size: 15px;
      line-height: 1.3;
    }
    .front-tab {
      right: 0;
      left: auto !important;
    }
  }
</style>
