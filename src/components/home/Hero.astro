---
/**
 * Home hero. The chapter logo's wave becomes a live three-phase current: one
 * sine per society, 120° apart, flowing across the screen. Below it, a stack
 * of file folders (one per society, then events); pointing at a society's
 * folder brings its phase forward. The front folder is the chapter itself.
 */
import { site } from '../../config/site';
import { societies } from '../../config/societies';
import { formatDate, getEvents, url } from '../../lib/utils';
import Arrow from '../Arrow.astro';

const { upcoming } = await getEvents();
const next = upcoming[0];

// Three-phase waveform, sampled at build time. One wavelength is 400 units;
// paths run one extra wavelength so the flow animation can loop seamlessly.
const wavelength = 400;
const amplitude = 46;
const mid = 60;
const phasePath = (phaseDeg: number) => {
  const points: string[] = [];
  for (let x = 0; x <= 1200 + wavelength; x += 6) {
    const y = mid - amplitude * Math.sin((2 * Math.PI * x) / wavelength - (phaseDeg * Math.PI) / 180);
    points.push(`${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`);
  }
  return points.join('');
};
const phases = societies.map((s, i) => ({ key: s.field, id: s.id, d: phasePath(i * 120) }));

// Society logos cut from the chapter logo: white on green and blue, black on orange.
const tabLogo = { ias: '/logos/ias-white.webp', ies: '/logos/ies-black.webp', pes: '/logos/pes-white.webp' };

const folders: { key: string; tab: string; logo?: string; href: string; title: string; detail: string }[] = [
  ...societies.map((s) => ({
    key: s.field,
    tab: s.id,
    logo: tabLogo[s.field],
    href: url(`/about/#${s.id.toLowerCase()}`),
    title: s.name,
    detail: s.role,
  })),
  {
    key: 'blue',
    tab: 'Events',
    href: next ? url(`/events/${next.id}/`) : url('/events/'),
    title: next ? `Next: ${next.data.title}` : 'Events',
    detail: next ? formatDate(next.data.date) : 'See past events',
  },
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-head">
    <h1 id="hero-title" class="hero-title" data-reveal>
      <span class="sr-only">IEEE {site.studentBranch} Joint Chapter: Industry Applications, Industrial Electronics and Power &amp; Energy societies</span>
      <!-- Both logos are decorative here: the heading text above names the chapter. -->
      <img
        src={url(site.logoColour)}
        alt=""
        aria-hidden="true"
        width="1248"
        height="494"
        class="hero-logo logo-light"
        fetchpriority="high"
      />
      <img src={url(site.logoWhite)} alt="" width="1248" height="495" class="hero-logo logo-dark" aria-hidden="true" />
    </h1>
    <p class="hero-sub" data-reveal style="--i: 1">
      The IEEE Industry Applications, Industrial Electronics and Power &amp; Energy societies, together in one
      student chapter.
    </p>
    <p class="hero-roll" data-reveal style="--i: 2">
      Join us for
      <span class="sr-only">workshops, industrial visits, competitions and talks.</span>
      <span class="roll" aria-hidden="true">
        <span class="roll-track">
          <span class="roll-word roll-ias">workshops</span>
          <span class="roll-word roll-ies">industrial visits</span>
          <span class="roll-word roll-pes">competitions</span>
          <span class="roll-word roll-ias">talks</span>
          <span class="roll-word roll-ias">workshops</span>
        </span>
      </span>
    </p>
  </div>

  <svg class="wave" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <g class="flow">
      {phases.map((p, i) => <path class={`phase phase-${p.key}`} d={p.d} pathLength="1" style={`--p: ${i}`} />)}
    </g>
  </svg>

  <nav class="folders" aria-label="Explore the chapter">
    {
      folders.map((f, i) => (
        <a href={f.href} class={`folder field-${f.key}`} style={`--n: ${i}`}>
          <span class:list={['tab tab-shape', { 'tab-logo': f.logo }]} aria-hidden="true">
            {f.logo ? <img src={url(f.logo)} alt="" height="160" class="tab-img" /> : f.tab}
          </span>
          <span class="strip">
            <span class="strip-text">
              <span class="strip-title">{f.title}</span>
              <span class="strip-detail">{f.detail}</span>
            </span>
            <Arrow size={22} class="strip-arrow" />
          </span>
        </a>
      ))
    }
    <div class="folder front field-black" style="--n: 4">
      <span class="tab tab-shape front-tab" aria-hidden="true">The chapter</span>
      <div class="front-body">
        <p class="front-statement">One chapter, three IEEE societies, every engineering student welcome.</p>
        <div class="front-action">
          <a href={url('/join/')} class="btn">
            Join the chapter <Arrow size={20} />
          </a>
          <p class="front-note">Open to every IEEE student member at {site.university}.</p>
        </div>
      </div>
    </div>
  </nav>
</section>

<style>
  /* Solid canvas: the hero has its own wave, the background waves stay behind it. */
  .hero {
    position: relative;
    background: var(--canvas);
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
  }
  .hero-head {
    padding-top: clamp(24px, 4svh, 48px);
    text-align: center;
  }
  .hero-title { margin: 0; }
  .hero-logo {
    display: block;
    animation: logo-in 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    width: min(1100px, 88vw);
    height: auto;
    margin-inline: auto;
  }
  @keyframes logo-in {
    from { opacity: 0; transform: translateY(18px) scale(0.97); }
  }
  /* The colour logo on light pages, the white one in dark mode. */
  .logo-dark { display: none; }
  :global([data-theme='dark']) .logo-light { display: none; }
  :global([data-theme='dark']) .logo-dark { display: block; }
  .hero-sub {
    max-width: 46ch;
    margin: clamp(20px, 3svh, 32px) auto 0;
    font-size: 20px;
    line-height: 1.5;
  }

  /* ----- Rolling word: an analog-counter roll through what the chapter runs ----- */
  .hero-roll {
    margin: 8px auto 0;
    font-size: 20px;
    line-height: 1.8;
  }
  .roll {
    display: inline-block;
    height: 1.8em;
    margin-left: 0.3em;
    overflow: hidden;
    vertical-align: top;
    text-align: left;
  }
  .roll-track { display: flex; flex-direction: column; }
  /* Each word box is taller than the window, so the previous word's underline stays out of view. */
  .roll-word {
    flex: none;
    height: 2.4em;
    line-height: 1.8;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }
  .roll-ias { text-decoration-color: var(--ias); }
  .roll-ies { text-decoration-color: var(--ies); }
  .roll-pes { text-decoration-color: var(--pes); }
  :global([data-theme='dark']) .roll-ias { text-decoration-color: #2fae55; }
  :global([data-theme='dark']) .roll-pes { text-decoration-color: #5b8fd6; }
  @media (prefers-reduced-motion: no-preference) {
    .roll-track { animation: roll 10s cubic-bezier(0.7, 0, 0.2, 1) infinite; }
  }
  @keyframes roll {
    0%, 20% { transform: translateY(0); }
    25%, 45% { transform: translateY(-2.4em); }
    50%, 70% { transform: translateY(-4.8em); }
    75%, 95% { transform: translateY(-7.2em); }
    100% { transform: translateY(-9.6em); }
  }

  /* ----- Three-phase waveform ----- */
  .wave {
    display: block;
    width: 100%;
    height: clamp(72px, 12svh, 120px);
    margin-top: clamp(16px, 3svh, 32px);
    overflow: visible;
  }
  .phase {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    transition: opacity 240ms ease, stroke-width 240ms ease;
  }
  .phase-ias { stroke: var(--ias); }
  .phase-ies { stroke: var(--ies); }
  .phase-pes { stroke: var(--pes); }
  /* PES blue and IAS green are too dark on the dark theme's canvas: lift the lines only. */
  :global([data-theme='dark']) .phase-pes { stroke: #5b8fd6; }
  :global([data-theme='dark']) .phase-ias { stroke: #2fae55; }

  @media (prefers-reduced-motion: no-preference) {
    .flow { animation: flow 7s linear infinite; }
    .phase {
      /* The dash exists only while drawing in (fill-mode backwards): with a stretched viewBox and
         non-scaling strokes the dash length is slightly off, which would leave a gap afterwards. */
      animation: phase-draw 1600ms cubic-bezier(0.6, 0, 0.2, 1) backwards;
      animation-delay: calc(300ms + var(--p) * 220ms);
    }
  }
  @keyframes phase-draw {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; }
  }
  @keyframes flow {
    from { transform: translateX(-400px); }
    to { transform: translateX(0); }
  }

  /* Pointing at a society's folder brings its phase forward. */
  .hero:has(.folder.field-ias:is(:hover, :focus-visible)) .phase:not(.phase-ias),
  .hero:has(.folder.field-ies:is(:hover, :focus-visible)) .phase:not(.phase-ies),
  .hero:has(.folder.field-pes:is(:hover, :focus-visible)) .phase:not(.phase-pes) {
    opacity: 0.15;
  }
  .hero:has(.folder.field-ias:is(:hover, :focus-visible)) .phase-ias,
  .hero:has(.folder.field-ies:is(:hover, :focus-visible)) .phase-ies,
  .hero:has(.folder.field-pes:is(:hover, :focus-visible)) .phase-pes {
    stroke-width: 7;
  }

  /* ----- Folder stack ----- */
  .folders {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: min(86%, 1320px);
    margin-inline: auto;
    padding-top: 72px; /* room for the first tab */
  }
  .folder {
    position: relative;
    z-index: calc(var(--n) + 1);
    display: block;
    text-decoration: none;
    transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
    animation: folder-rise 720ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(200ms + var(--n) * 90ms);
  }
  @keyframes folder-rise {
    from { transform: translateY(48px); }
  }
  a.folder:hover,
  a.folder:focus-visible {
    transform: translateY(-10px);
  }
  a.folder:focus-visible {
    outline-offset: -3px;
  }

  .tab {
    position: absolute;
    bottom: 100%;
    left: var(--tab-x);
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 168px;
    height: 56px;
    padding: 0 32px;
    background: inherit;
    font-size: 17px;
    font-weight: 500;
    white-space: nowrap;
  }
  .tab-img {
    width: auto;
    height: 42px;
  }
  .strip {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    min-height: 68px;
    padding: 0 24px;
  }
  .strip-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 16px;
    min-width: 0;
  }
  .strip-title {
    font-size: 17px;
    font-weight: 600;
  }
  .strip-detail {
    font-size: 17px;
  }
  .folder :global(.strip-arrow) {
    flex: none;
    transition: transform 240ms ease;
  }
  a.folder:hover :global(.strip-arrow) {
    transform: translateX(6px);
  }

  .front {
    flex: 1;
    border-radius: 0 0 var(--radius) var(--radius);
    min-height: 168px;
  }
  /* Each tab sits beside, not over, the text on the strip in front of it. */
  .folder:nth-of-type(1) { --tab-x: 0%; }
  .folder:nth-of-type(2) { --tab-x: 54%; }
  .folder:nth-of-type(3) { --tab-x: 65%; }
  .folder:nth-of-type(4) { --tab-x: 76%; }
  .front-tab {
    left: auto;
    right: 0;
  }
  .front-body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding: 28px 32px 40px;
  }
  .front-statement {
    max-width: 24ch;
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .front-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .front-note {
    font-size: 17px;
    max-width: 30ch;
  }

  @media (max-width: 767px) {
    .hero-head {
      padding-top: 48px;
    }
    .hero-logo {
      width: 100%;
    }
    .hero-sub {
      font-size: 17px;
    }
    .front-body {
      padding: 24px var(--gutter) 32px;
    }
    .front-action,
    .front-action .btn {
      width: 100%;
    }

  }

  /* Below desktop the next tab would cover the strip's text: stagger the tabs
     left, centre, right and keep a clear band at the bottom of each strip. */
  @media (max-width: 1099px) {
    .folders {
      width: 100%;
      padding-top: 52px;
    }
    .tab {
      height: 44px;
      min-width: 112px;
      padding: 0 22px;
      font-size: 15px;
    }
    .tab-img {
      height: 32px;
    }
    .folder:nth-of-type(3n + 1) .tab { left: 0; }
    .folder:nth-of-type(3n + 2) .tab { left: calc(50% - 56px); }
    .folder:nth-of-type(3n + 3) .tab { left: auto; right: 0; }
    .strip {
      align-items: flex-start;
      min-height: 0;
      padding: 10px var(--gutter) 54px;
    }
    .strip-text {
      flex-direction: column;
      row-gap: 0;
    }
    .strip-title {
      font-size: 16px;
      line-height: 1.3;
    }
    .strip-detail {
      font-size: 15px;
      line-height: 1.3;
    }
    .front-tab {
      right: 0;
      left: auto !important;
    }
  }
</style>

<script>
  // Resonance: with a mouse, the three-phase waves swell around the pointer in
  // proportion to its speed (plus a faint electric crackle), then settle back.
  // Takes over the CSS flow while active; does nothing on touch screens or with
  // reduced motion, where the CSS animation (or a still wave) remains.
  const hero = document.querySelector<HTMLElement>('.hero');
  const svg = hero?.querySelector<SVGSVGElement>('.wave');
  if (hero && svg && matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    const flow = svg.querySelector<SVGGElement>('.flow')!;
    const paths = [...svg.querySelectorAll<SVGPathElement>('.phase')];
    const WAVELENGTH = 400;
    const AMPLITUDE = 46;
    const MID = 60;
    const PERIOD = 7000;
    let pointerX = 600;
    let energy = 0;
    let last: { x: number; y: number; t: number } | null = null;
    let running = false;
    const start = performance.now();

    flow.style.animation = 'none';

    hero.addEventListener('pointermove', (e) => {
      const r = svg.getBoundingClientRect();
      pointerX = ((e.clientX - r.left) / r.width) * 1200;
      const now = performance.now();
      if (last) {
        const speed = Math.hypot(e.clientX - last.x, e.clientY - last.y) / Math.max(8, now - last.t);
        energy = Math.min(1, energy + speed * 0.09);
      }
      last = { x: e.clientX, y: e.clientY, t: now };
    });

    const draw = (now: number) => {
      const phase = ((now - start) / PERIOD) * 2 * Math.PI;
      energy *= 0.965;
      paths.forEach((path, i) => {
        const offset = (i * 2 * Math.PI) / 3;
        let d = '';
        for (let x = 0; x <= 1200; x += 6) {
          const g = Math.exp(-(((x - pointerX) / 180) ** 2));
          const swell = 1 + 1.25 * energy * g;
          const crackle = energy * g * 7 * Math.sin(x * 0.21 + phase * 9 + i);
          const y = MID - AMPLITUDE * swell * Math.sin((2 * Math.PI * x) / WAVELENGTH - phase - offset) + crackle;
          d += `${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`;
        }
        path.setAttribute('d', d);
      });
      if (running) requestAnimationFrame(draw);
    };

    // Only animate while the hero is on screen.
    new IntersectionObserver(([entry]) => {
      const visible = entry.isIntersecting;
      if (visible && !running) {
        running = true;
        requestAnimationFrame(draw);
      } else if (!visible) {
        running = false;
      }
    }).observe(svg);
  }
</script>
