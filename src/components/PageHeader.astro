---
/**
 * Every inner page opens on its chapter colour (see DESIGN.md → Page header),
 * optionally with one picture filling its right half.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  field?: 'black' | 'blue' | 'pes' | 'ies' | 'ias';
  /** 'md' for long titles such as event and news headlines. */
  size?: 'lg' | 'md';
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, lead, field = 'black', size = 'lg', image, imageAlt = '' } = Astro.props;
---
<section class:list={['page-header field', `field-${field}`, { 'with-image': image }]} aria-labelledby="page-title">
  <div class:list={['wrap', { 'has-image': image }]}>
    <div class="text">
      <h1 id="page-title" class={size === 'lg' ? 't-display-lg max-w-[14ch]' : 'title-md'} data-reveal>{title}</h1>
      {lead && <p class="lead" data-reveal style="--i: 1">{lead}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="picture" data-reveal style="--i: 2">
          <Image src={image} alt={imageAlt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" class="picture-img" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-header {
    padding-top: clamp(80px, 12vw, 160px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  /* With a picture: the picture fills the right half of the band, edge to edge (square, it touches the screen). */
  .with-image { position: relative; display: flex; align-items: flex-end; min-height: clamp(420px, 60svh, 600px); padding-top: clamp(64px, 8vw, 112px); }
  .has-image { width: 100%; }
  .has-image .text { width: 46%; }
  .picture {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
  }
  .picture :global(.picture-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: header-drift 24s ease-in-out infinite alternate;
  }
  @keyframes header-drift {
    from { transform: scale(1.02); }
    to { transform: scale(1.08) translateX(-1.5%); }
  }
  @media (max-width: 899px) {
    .with-image { display: block; min-height: 0; padding-top: 0; }
    .has-image { display: flex; flex-direction: column; }
    .has-image .text { width: auto; padding-top: clamp(32px, 7vw, 56px); }
    .picture { order: -1; position: relative; width: auto; margin-inline: calc(-1 * var(--gutter)); aspect-ratio: 16 / 10; }
  }
  .title-md {
    max-width: 24ch;
    font-size: clamp(24px, 3.2vw, 48px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .lead {
    max-width: 44ch;
    margin-top: clamp(20px, 2.4vw, 32px);
    font-size: 18px;
    line-height: 1.5;
  }
  @media (max-width: 639px) {
    .lead { font-size: 17px; }
  }
</style>
