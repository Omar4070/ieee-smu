---
/**
 * Every inner page opens on its chapter colour (see DESIGN.md → Page header).
 */
interface Props {
  title: string;
  lead?: string;
  field?: 'navy' | 'blue' | 'pes' | 'ies' | 'ias';
}
const { title, lead, field = 'navy' } = Astro.props;
---
<section class={`page-header field field-${field}`} aria-labelledby="page-title">
  <div class="wrap">
    <h1 id="page-title" class="t-display-lg max-w-[14ch]" data-reveal>{title}</h1>
    {lead && <p class="lead" data-reveal style="--i: 1">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-top: clamp(80px, 12vw, 160px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .lead {
    max-width: 44ch;
    margin-top: clamp(24px, 3vw, 40px);
    font-size: 20px;
    line-height: 1.5;
  }
  @media (max-width: 639px) {
    .lead { font-size: 18px; }
  }
</style>
