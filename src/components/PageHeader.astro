---
/**
 * Every inner page opens on its chapter colour (see DESIGN.md → Page header),
 * optionally with one picture on the right.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  field?: 'navy' | 'blue' | 'pes' | 'ies' | 'ias';
  /** 'md' for long titles such as event and news headlines. */
  size?: 'lg' | 'md';
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, lead, field = 'navy', size = 'lg', image, imageAlt = '' } = Astro.props;
---
<section class:list={['page-header field', `field-${field}`, { 'with-image': image }]} aria-labelledby="page-title">
  <div class:list={['wrap', { 'has-image': image }]}>
    <div class="text">
      <h1 id="page-title" class={size === 'lg' ? 't-display-lg max-w-[14ch]' : 'title-md'} data-reveal>{title}</h1>
      {lead && <p class="lead" data-reveal style="--i: 1">{lead}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="picture" data-reveal style="--i: 2">
          <Image src={image} alt={imageAlt} widths={[400, 640, 900]} sizes="(min-width: 900px) 34vw, 92vw" loading="eager" class="picture-img" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-header {
    padding-top: clamp(80px, 12vw, 160px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .has-image {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px 24px;
    align-items: end;
  }
  .has-image .text { grid-column: 1 / span 7; }
  .picture { grid-column: 8 / span 5; }
  .with-image { padding-top: clamp(48px, 6vw, 96px); }
  .picture :global(.picture-img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 899px) {
    .has-image { display: flex; flex-direction: column; align-items: stretch; }
    .picture :global(.picture-img) { aspect-ratio: 16 / 10; }
  }
  .title-md {
    max-width: 24ch;
    font-size: clamp(30px, 5vw, 76px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .lead {
    max-width: 44ch;
    margin-top: clamp(24px, 3vw, 40px);
    font-size: 20px;
    line-height: 1.5;
  }
  @media (max-width: 639px) {
    .lead { font-size: 18px; }
  }
</style>
