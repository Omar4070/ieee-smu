---
/**
 * "Power-on" opening on the home page, once per visit (about 1.6s). A calm navy
 * screen: the chapter logo appears and, below it, the three phases sweep across
 * the full width. Then the screen lifts, followed closely by a green, an orange
 * and a blue sheet, all moving the same way, and the page is there. Timed
 * entirely in CSS; the head script in BaseLayout adds html.intro only on the
 * first visit of a session and never under reduced motion. Any click, key, wheel
 * or touch skips it, and it never blocks clicks (pointer-events: none).
 */
import { site } from '../config/site';
import { url } from '../lib/utils';

// The hero's own waveform; one extra wavelength so it can flow while it sweeps in.
const phase = (deg: number) => {
  const pts: string[] = [];
  for (let x = 0; x <= 1600; x += 6) {
    const y = 60 - 46 * Math.sin((2 * Math.PI * x) / 400 - (deg * Math.PI) / 180);
    pts.push(`${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`);
  }
  return pts.join('');
};
const waves = [
  { key: 'ias', d: phase(0) },
  { key: 'ies', d: phase(120) },
  { key: 'pes', d: phase(240) },
];
---
<div class="power-on" aria-hidden="true">
  <span class="po-sheet po-pes" style="--n: 3"></span>
  <span class="po-sheet po-ies" style="--n: 2"></span>
  <span class="po-sheet po-ias" style="--n: 1"></span>
  <div class="po-sheet po-stage" style="--n: 0">
    <img class="po-logo" src={url(site.logoWhite)} alt="" width="1248" height="495" decoding="sync" />
    <svg class="po-waves" viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
      <g class="po-flow">
        {waves.map((w) => <path class={`po-wave po-wave-${w.key}`} d={w.d} />)}
      </g>
    </svg>
  </div>
</div>

<style is:global>
  .power-on { display: none; }
  html.intro .power-on {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 200;
    overflow: hidden;
    pointer-events: none;
  }
  html.intro-skip .power-on { animation: po-skip 220ms ease forwards; }
  @keyframes po-skip { to { opacity: 0; } }

  /* The stage and the three colour sheets are stacked; they lift one after the other, same direction. */
  .po-sheet {
    position: absolute;
    inset: 0;
    animation: po-lift 560ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
    animation-delay: calc(850ms + var(--n) * 60ms);
    will-change: transform;
  }
  @keyframes po-lift { to { transform: translateY(-101%); } }
  .po-ias { background: var(--ias); }
  .po-ies { background: var(--ies); }
  .po-pes { background: var(--pes); }

  .po-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 5svh, 48px);
    background: #0b1a2e;
  }
  .po-logo {
    width: min(520px, 76vw);
    height: auto;
    animation: po-logo 420ms cubic-bezier(0.2, 0.7, 0.2, 1) 60ms backwards;
  }
  @keyframes po-logo { from { opacity: 0; transform: translateY(10px); } }

  /* The lines sit below the logo, edge to edge. They arrive with one clip sweep rather than a stroke
     dash: on a stretched viewBox a dash is measured wrongly and the lines stop short of the edge. */
  .po-waves {
    flex: none;
    width: 100%;
    height: clamp(72px, 13svh, 120px);
    animation: po-sweep 650ms cubic-bezier(0.6, 0, 0.2, 1) 100ms backwards;
  }
  @keyframes po-sweep { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .po-flow { animation: po-flow 1600ms linear both; }
  @keyframes po-flow {
    from { transform: translateX(-400px); }
    to { transform: translateX(0); }
  }
  .po-wave {
    fill: none;
    stroke-width: 4;
    vector-effect: non-scaling-stroke;
  }
  .po-wave-ias { stroke: #2fae55; }
  .po-wave-ies { stroke: #ff7a2f; }
  .po-wave-pes { stroke: #5b8fd6; }
</style>

<script>
  const root = document.documentElement;
  if (root.classList.contains('intro')) {
    const end = () => root.classList.remove('intro', 'intro-skip');
    const timer = setTimeout(end, 1640);
    const skip = () => {
      clearTimeout(timer);
      root.classList.add('intro-skip');
      setTimeout(end, 240);
      ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((t) => removeEventListener(t, skip));
    };
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((t) => addEventListener(t, skip, { passive: true }));
  }
</script>
