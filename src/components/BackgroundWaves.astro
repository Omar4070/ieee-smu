---
/**
 * The chapter's three-phase wave as a living background behind every page:
 * four faint bands of three sines (IAS green, IES orange, PES blue, 120° apart)
 * spread evenly over the whole viewport, flowing in alternating directions at
 * different speeds. Fixed to the viewport, behind all content; canvas and grey
 * sections let it show through, while colour fields, photos and tiles sit on top.
 */
const keys = ['ias', 'ies', 'pes'];

const phases = (wavelength: number, amplitude: number, mid: number) =>
  [0, 120, 240].map((deg) => {
    const pts: string[] = [];
    for (let x = 0; x <= 1200 + wavelength; x += 8) {
      const y = mid - amplitude * Math.sin((2 * Math.PI * x) / wavelength - (deg * Math.PI) / 180);
      pts.push(`${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`);
    }
    return pts.join('');
  });

// One band per quarter of the screen; each flows the opposite way to its neighbour.
const bands = [
  { top: '4vh', wavelength: 600, seconds: 28, reverse: false },
  { top: '28vh', wavelength: 820, seconds: 38, reverse: true },
  { top: '52vh', wavelength: 700, seconds: 32, reverse: false },
  { top: '76vh', wavelength: 900, seconds: 42, reverse: true },
].map((b) => ({ ...b, paths: phases(b.wavelength, 56, 80) }));
---
<div class="bg-waves" aria-hidden="true">
  {
    bands.map((b) => (
      <svg
        class="band"
        viewBox="0 0 1200 160"
        preserveAspectRatio="none"
        focusable="false"
        style={`top:${b.top};--shift:-${b.wavelength}px;--t:${b.seconds}s`}
      >
        <g class:list={['flow', { reverse: b.reverse }]}>
          {b.paths.map((d, i) => (
            <path class={`line line-${keys[i]}`} d={d} />
          ))}
        </g>
      </svg>
    ))
  }
</div>

<style>
  .bg-waves {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.18;
  }
  :global([data-theme='dark']) .bg-waves { opacity: 0.2; }

  .band {
    position: absolute;
    left: 0;
    width: 100%;
    height: 20vh;
    overflow: visible;
  }

  .line {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .line-ias { stroke: var(--ias); }
  .line-ies { stroke: var(--ies); }
  .line-pes { stroke: var(--pes); }
  :global([data-theme='dark']) .line-ias { stroke: #2fae55; }
  :global([data-theme='dark']) .line-pes { stroke: #5b8fd6; }

  .flow { will-change: transform; }
  @media (prefers-reduced-motion: no-preference) {
    .flow { animation: bg-flow var(--t) linear infinite; }
    .flow.reverse { animation-direction: reverse; }
  }
  @keyframes bg-flow {
    from { transform: translateX(0); }
    to { transform: translateX(var(--shift)); }
  }
</style>
