---
import { nav, site } from '../config/site';
import { isCurrent, url } from '../lib/utils';

const path = Astro.url.pathname;
---
<header class="site-header field-blue field">
  <div class="wrap flex h-[var(--header-h)] items-center justify-between gap-6">
    <a href={url('/')} class="wordmark flex items-center gap-3 no-underline" aria-label={`${site.name}, home`}>
      <img src={url(site.logoWhite)} alt="" width="1248" height="495" class="header-logo" />
    </a>

    <nav aria-label="Main" class="hidden min-[900px]:block">
      <ul class="flex items-center gap-1" role="list">
        {
          nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class="nav-link"
                aria-current={isCurrent(item.href, path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch to dark theme">
        <svg class="theme-sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" />
        </svg>
        <svg class="theme-moon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" />
        </svg>
      </button>
      <a href={url('/join/')} class="btn header-join hidden min-h-11! px-5! py-2! min-[900px]:inline-flex" aria-current={isCurrent('/join/', path) ? 'page' : undefined}>
        Join
      </a>
      <button
        type="button"
        class="icon-btn menu-btn"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Menu</span>
        <svg class="menu-open" width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M3 7h18M3 17h18" />
        </svg>
        <svg class="menu-close" width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Scroll progress: three phase lines that fill as the page is read. -->
  <div class="meter" aria-hidden="true">
    <span class="meter-line meter-ias"></span>
    <span class="meter-line meter-ies"></span>
    <span class="meter-line meter-pes"></span>
  </div>

  <div id="mobile-menu" class="mobile-menu field-blue" hidden>
    <nav aria-label="Main" class="wrap pt-6 pb-10">
      <ul role="list" class="flex flex-col">
        {
          [{ href: '/', label: 'Home' }, ...nav, { href: '/join/', label: 'Join the chapter' }].map((item) => (
            <li>
              <a
                href={url(item.href)}
                class="mobile-link"
                aria-current={
                  (item.href === '/' ? path.replace(/\/$/, '') === url('/').replace(/\/$/, '') : isCurrent(item.href, path))
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .wordmark { text-decoration: none; }

  .meter {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
    pointer-events: none;
  }
  .meter-line { height: 2px; transform-origin: left center; transform: scaleX(0); }
  .meter-ias { background: #3ccf6b; }
  .meter-ies { background: #ff8a3d; }
  .meter-pes { background: #9fd6ff; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .meter { display: flex; }
      .meter-line { animation: meter-fill linear both; animation-timeline: scroll(root); }
      /* Three phases: the same reading, each line easing differently so they ripple. */
      .meter-ies { animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1); }
      .meter-pes { animation-timing-function: cubic-bezier(0.6, 0, 0.9, 0.6); }
    }
  }
  @keyframes meter-fill { to { transform: scaleX(1); } }
  .header-logo { width: auto; height: 56px; }

  /* Coloured menu tabs: each link takes a society colour in logo order
     (green, orange, blue, then again). Hover tints the tab; the current
     page fills it. Orange takes black text, the others white. */
  li:nth-child(3n + 1) { --tab: var(--ias); --tab-ink: #fff; --tab-line: #3ccf6b; }
  li:nth-child(3n + 2) { --tab: var(--ies); --tab-ink: #000; --tab-line: #ff8a3d; }
  li:nth-child(3n + 3) { --tab: var(--pes); --tab-ink: #fff; --tab-line: #9fd6ff; }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-sm);
    font-size: 17px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }
  /* Every link carries a short bar in its colour (lighter tints so they read
     on the blue bar); it stretches to the full tab on hover. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 3px;
    border-radius: 3px;
    background: var(--tab-line);
    transform: scaleX(0.35);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nav-link:hover { background: color-mix(in srgb, var(--tab) 28%, transparent); }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link[aria-current='page'] {
    background: var(--tab);
    color: var(--tab-ink);
  }
  .nav-link[aria-current='page']::after { transform: scaleX(0); }

  /* White Join button so it stands out on the blue bar. */
  .header-join { background: #fff; color: var(--primary); }
  .header-join:hover { background: #e6f1f7; }
  .header-join:active { background: #d4e7f1; }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--radius-sm);
    touch-action: manipulation;
    transition: background-color 160ms ease;
  }
  .icon-btn:hover { background: rgb(255 255 255 / 0.12); }
  .icon-btn > svg { grid-area: 1 / 1; }

  .theme-moon { display: none; }
  :global([data-theme='dark']) .theme-sun { display: none; }
  :global([data-theme='dark']) .theme-moon { display: block; }

  @media (min-width: 900px) {
    .menu-btn { display: none; }
  }

  .menu-close { display: none; }
  [aria-expanded='true'] .menu-open { display: none; }
  [aria-expanded='true'] .menu-close { display: block; }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 64px;
    font-size: clamp(26px, 6.5vw, 34px);
    font-weight: 300;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .mobile-link {
    border-left: 6px solid transparent;
    padding-left: 14px;
    transition: border-color 180ms ease;
  }
  .mobile-link:hover { border-left-color: var(--tab-line); }
  .mobile-link[aria-current='page'] {
    border-left-color: var(--tab-line);
    font-weight: 500;
  }
  @media (min-width: 900px) {
    .mobile-menu { display: none !important; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }

  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (themeBtn) {
    const sync = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      themeBtn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    };
    sync();
    themeBtn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    });
  }
</script>
