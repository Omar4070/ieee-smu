---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Avatar from '../components/Avatar.astro';
import Arrow from '../components/Arrow.astro';
import SocietyLogo from '../components/SocietyLogo.astro';
import { getTeams, url } from '../lib/utils';
import { Image } from 'astro:assets';
import cobot from '../assets/found/ias-cobot-arm.jpg';
import robots from '../assets/found/ias-robot-line.jpg';

const [current, ...past] = await getTeams();
---
<BaseLayout
  title="Team"
  description="The executive committee of the IEEE SMU Student Branch Joint Chapter, current and past."
>
  <PageHeader
    field="ies"
    title="The team"
    lead="Student volunteers who plan every workshop, visit and competition. A new committee is elected each October."
    image={cobot}
    imageAlt="A collaborative robot arm on a steel work table"
  />

  {
    current && (
      <section class="section bg-canvas" aria-labelledby="current-title">
        <div class="wrap">
          <h2 id="current-title" class="t-headline" data-reveal>
            Executive committee {current.data.year}
          </h2>
          <ul class="roster" role="list">
            {current.data.members.map((m, i) => (
              <li class="member" data-reveal style={`--i: ${i % 2}`}>
                <Avatar name={m.name} photo={m.photo} society={m.society} size={112} />
                <div class="min-w-0">
                  <h3 class="member-name">{m.name}</h3>
                  <p class="member-role">{m.role}</p>
                  {m.society && (
                    <div class="mt-2">
                      <SocietyLogo society={m.society} height={40} />
                    </div>
                  )}
                  {m.linkedin && (
                    <a href={m.linkedin} class="link mt-2 inline-flex items-center gap-1" rel="noopener">
                      LinkedIn<span class="sr-only"> profile of {m.name}</span>
                      <Arrow size={16} direction="up-right" />
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="section field-surface" aria-labelledby="past-title">
        <div class="wrap past-wrap">
          <h2 id="past-title" class="t-headline" data-reveal>
            Past committees
          </h2>
          <div class="past">
            {past.map((team) => (
              <section aria-labelledby={`team-${team.id}`} data-reveal>
                <h3 id={`team-${team.id}`} class="past-year tabular-nums">
                  {team.data.year}
                </h3>
                <ul role="list" class="mt-4 flex flex-col gap-2">
                  {team.data.members.map((m) => (
                    <li>
                      <span class="font-medium">{m.name}</span>
                      <span class="text-ink-muted">, {m.role}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section bg-canvas" aria-labelledby="volunteer-title">
    <div class="wrap volunteer">
      <div data-reveal>
        <h2 id="volunteer-title" class="t-headline">Help run the chapter</h2>
        <p class="mt-6 max-w-[44ch]">
          You do not need to wait for the elections. Every event needs people for logistics, design, photos and
          speakers. Tell us what you would like to do.
        </p>
        <a href={url('/contact/')} class="btn mt-8">
          Contact the committee <Arrow size={18} />
        </a>
      </div>
      <Image
        src={robots}
        alt="Industrial robots stacking crates along a production line"
        widths={[480, 720, 960]}
        sizes="(min-width: 900px) 45vw, 92vw"
        class="volunteer-img photo-reveal"
        data-reveal
        style="--i: 1"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .roster {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 24px;
    margin-top: 64px;
  }
  .member {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .member-name {
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .member-role { margin-top: 4px; font-size: 20px; }

  .past-wrap {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px 24px;
  }
  .past-wrap > h2 { grid-column: 1 / span 4; }
  .past {
    grid-column: 5 / span 8;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 48px 24px;
  }
  .volunteer {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 24px;
    align-items: center;
  }
  .volunteer :global(.volunteer-img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .past-year {
    font-size: clamp(22px, 2.1vw, 30px);
    font-weight: 300;
  }

  @media (max-width: 899px) {
    .past-wrap, .volunteer { display: flex; flex-direction: column; align-items: stretch; }
  }
  @media (max-width: 767px) {
    .roster { grid-template-columns: 1fr; gap: 32px; margin-top: 40px; }
    .member { gap: 20px; }
    .member :global(.avatar) { width: 80px !important; height: 80px !important; font-size: 28px !important; }
    .member-role { font-size: 17px; }
  }
</style>
