---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Arrow from '../../components/Arrow.astro';
import SocietyLogo from '../../components/SocietyLogo.astro';
import { fieldFor, formatRange, getEvents, isoDate, url } from '../../lib/utils';
import lightning from '../../assets/found/mood-lightning.jpg';

const { upcoming, past } = await getEvents();

// Past events grouped by year, newest first.
const byYear = new Map<number, typeof past>();
for (const e of past) {
  const y = e.data.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), e]);
}
---
<BaseLayout
  title="Events"
  description="Workshops, conferences, industrial visits and competitions run by the IEEE SMU Student Branch Joint Chapter."
>
  <PageHeader
    field="black"
    title="Events"
    lead="Workshops, talks, industrial visits and competitions. Open to every engineering student; most are free."
    image={lightning}
    imageAlt="A lightning bolt striking from a blue storm cloud"
  />

  <section class="section" aria-labelledby="upcoming-title">
    <div class="wrap">
      <h2 id="upcoming-title" class="t-headline" data-reveal>Upcoming</h2>

      {
        upcoming.length === 0 && (
          <p class="t-statement mt-10 max-w-[32ch]">
            Nothing scheduled right now. New events are announced here and on our social media first.
          </p>
        )
      }

      <ul class="mt-12 flex flex-col gap-20 md:gap-28" role="list">
        {
          upcoming.map((e, i) => (
            <li class="upcoming">
              <div class={`upcoming-media ${fieldFor(e.data.societies[0])}`} data-reveal data-tilt>
                <Image
                  src={e.data.cover}
                  alt={e.data.coverAlt}
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 900px) 50vw, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="upcoming-img photo-reveal"
                />
              </div>
              <div class="upcoming-body" data-reveal style="--i: 1">
                <p class="t-title">
                  <time datetime={isoDate(e.data.date)}>{formatRange(e.data.date, e.data.endDate)}</time>
                  {e.data.time && <span> · {e.data.time}</span>}
                </p>
                <h3 class="t-statement mt-4 max-w-[24ch]">
                  <a href={url(`/events/${e.id}/`)} class="title-link">
                    {e.data.title}
                  </a>
                </h3>
                <p class="mt-6 max-w-[48ch]">{e.data.summary}</p>
                <p class="meta-row mt-4">
                  <span class="meta-logos">
                    {e.data.societies.map((s) => <SocietyLogo society={s} height={48} />)}
                  </span>
                  <span>{e.data.type} · {e.data.location}</span>
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                  {e.data.registrationUrl && (
                    <a href={e.data.registrationUrl} class="btn" rel="noopener">
                      Register <Arrow size={18} />
                    </a>
                  )}
                  <a href={url(`/events/${e.id}/`)} class="btn btn-inverse">
                    Details
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section field-surface" aria-labelledby="archive-title">
    <div class="wrap">
      <h2 id="archive-title" class="t-headline" data-reveal>Past events</h2>
      <p class="mt-6 max-w-[48ch]" data-reveal style="--i: 1">
        Every event we have run, with photos and results.
      </p>

      {
        past.length === 0 ? (
          <p class="mt-10">The archive starts after our first event.</p>
        ) : (
          <div class="archive">
            {[...byYear].map(([year, events]) => (
              <section class="archive-year" aria-labelledby={`year-${year}`}>
                <h3 id={`year-${year}`} class="year tabular-nums">
                  {year}
                </h3>
                <ul role="list">
                  {events.map((e) => (
                    <li class="row" data-reveal>
                      <a href={url(`/events/${e.id}/`)} class="row-link">
                        <span class="row-date">
                          <time datetime={isoDate(e.data.date)}>{formatRange(e.data.date, e.data.endDate)}</time>
                        </span>
                        <span class="row-title">{e.data.title}</span>
                        <span class="row-type">
                          {e.data.type}
                          {e.data.societies.map((s) => <SocietyLogo society={s} height={32} />)}
                        </span>
                      </a>
                      <div class="row-preview" aria-hidden="true">
                        <Image src={e.data.cover} alt="" widths={[320, 640, 900]} sizes="(min-width: 900px) 30vw, 40vw" class="preview-img" />
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .upcoming {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
  }
  .upcoming-media {
    grid-column: 1 / span 6;
    aspect-ratio: 4 / 3;
    padding: 8%;
    border-radius: var(--radius);
  }
  .upcoming-media :global(.upcoming-img) { width: 100%; height: 100%; object-fit: cover; }
  .upcoming-body { grid-column: 8 / span 5; }
  .upcoming:nth-child(even) .upcoming-media { grid-column: 7 / span 6; order: 2; }
  .upcoming:nth-child(even) .upcoming-body { grid-column: 1 / span 5; }
  .title-link { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; text-decoration-color: transparent; transition: text-decoration-color 160ms ease; }
  .title-link:hover { text-decoration-color: currentColor; }

  /* ----- Archive: index with preview ----- */
  .archive {
    position: relative;
    margin-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    /* tall enough for the preview frame (4 of 12 columns at 4:5) */
    min-height: calc(min(100vw, 1440px) * 0.31);
  }
  .archive-year {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .year {
    grid-column: 1 / span 2;
    font-size: clamp(26px, 2.4vw, 36px);
    font-weight: 300;
    line-height: 1;
  }
  .archive-year > ul { grid-column: 3 / span 6; }
  .row-link {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 4px 24px;
    padding: 20px 0;
    text-decoration: none;
    transition: opacity 240ms ease;
  }
  .row-date { grid-row: span 2; font-size: 17px; }
  .row-title { font-size: clamp(19px, 1.6vw, 24px); line-height: 1.15; letter-spacing: -0.01em; }
  .row-type { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 15px; color: var(--ink-muted); }
  .meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .meta-logos { display: inline-flex; align-items: center; gap: 14px; }
  .row-link:hover .row-title,
  .row-link:focus-visible .row-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }

  .row-preview {
    position: absolute;
    top: 0;
    right: 0;
    width: calc((100% - 11 * 24px) / 12 * 4 + 3 * 24px);
    aspect-ratio: 1;
    opacity: 0;
    overflow: hidden;
    border-radius: var(--radius);
    pointer-events: none;
    transition: opacity 240ms ease;
  }
  .row-preview :global(.preview-img) { width: 100%; height: 100%; object-fit: cover; }

  /* The first past event shows by default; pointing at another row swaps it. */
  .archive-year:first-child .row:first-child .row-preview { opacity: 1; }
  .archive:has(.row-link:hover, .row-link:focus-visible) .row-preview { opacity: 0; }
  .archive .row:has(.row-link:hover, .row-link:focus-visible) .row-preview { opacity: 1; }
  .archive:has(.row-link:hover, .row-link:focus-visible) .row-link:not(:hover, :focus-visible) { opacity: 0.4; }

  @media (max-width: 899px) {
    .upcoming { display: flex; flex-direction: column; align-items: stretch; gap: 32px; }
    .upcoming:nth-child(even) .upcoming-media { order: 0; }
    .archive { min-height: 0; }
    .archive-year { display: block; }
    .year { margin-bottom: 8px; }
    /* Touch screens: each row shows its own picture inline. */
    .row { display: grid; grid-template-columns: 1fr 96px; gap: 16px; align-items: center; }
    .row-link { grid-template-columns: 1fr; padding: 16px 0; }
    .row-date { grid-row: auto; font-size: 15px; }
    .row-preview { position: static; width: 96px; aspect-ratio: 1; opacity: 1 !important; }
    .archive:has(.row-link:hover) .row-link:not(:hover) { opacity: 1; }
  }
</style>
