---
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Arrow from '../../components/Arrow.astro';
import { formatDate, getNews, isoDate, url } from '../../lib/utils';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: news[i - 1], older: news[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'news'>;
  newer?: CollectionEntry<'news'>;
  older?: CollectionEntry<'news'>;
}

const { entry, newer, older } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const ogImage = data.cover ? await getImage({ src: data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
---
<BaseLayout title={data.title} description={data.summary} image={ogImage?.src} type="article">
  <PageHeader field="ias" size="md" title={data.title} lead={data.summary}>
    <p class="mt-8 flex flex-wrap items-center gap-3 text-[17px]" data-reveal style="--i: 2">
      <span class="tag field-black">{data.category}</span>
      <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
    </p>
  </PageHeader>

  <article class="section">
    <div class="wrap article">
      <div class="prose" data-reveal-children>
        <Content />
      </div>
      {
        data.cover && (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? ''}
            widths={[480, 720, 960]}
            sizes="(min-width: 900px) 38vw, 92vw"
            class="article-img photo-reveal"
            data-reveal
            style="--i: 1"
          />
        )
      }
    </div>
  </article>

  <nav class="section field-surface" aria-label="More news">
    <div class="wrap pager">
      {
        older && (
          <a href={url(`/news/${older.id}/`)} class="pager-link" data-reveal>
            <span class="t-small">Older</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        )
      }
      {
        newer && (
          <a href={url(`/news/${newer.id}/`)} class="pager-link pager-newer" data-reveal style="--i: 1">
            <span class="t-small">Newer</span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        )
      }
      <a href={url('/news/')} class="link inline-flex items-center gap-2 text-[20px] pager-all">
        <Arrow size={20} class="rotate-180" /> All news
      </a>
    </div>
  </nav>
</BaseLayout>

<style>
  .article {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    align-items: start;
  }
  .article .prose { grid-column: 1 / span 7; }
  .article :global(.article-img) { grid-column: 9 / span 4; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--canvas);
    text-decoration: none;
    transition: background-color 160ms ease;
  }
  .pager-link:hover { background: var(--surface-2); }
  .pager-newer { grid-column: 2; text-align: right; }
  .pager-title { font-size: 20px; font-weight: 500; line-height: 1.3; }
  .pager-all { grid-column: 1 / -1; margin-top: 24px; }

  @media (max-width: 899px) {
    .article { display: flex; flex-direction: column; }
    .article :global(.article-img) { aspect-ratio: 16 / 10; }
    .pager { grid-template-columns: 1fr; }
    .pager-newer { grid-column: auto; text-align: left; }
  }
</style>
