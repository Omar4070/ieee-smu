---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../config/site';
import sunset from '../assets/found/mood-sunset-lines.jpg';

const formAction = `https://formspree.io/f/${site.formspreeId}`;
const mapSrc =
  site.mapEmbedUrl ||
  `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
const social = [
  { href: site.social.linkedin, label: 'LinkedIn' },
  { href: site.social.instagram, label: 'Instagram' },
  { href: site.social.facebook, label: 'Facebook' },
];
---
<BaseLayout title="Contact" description={`Contact the IEEE SMU Student Branch Joint Chapter at ${site.university}.`}>
  <PageHeader
    field="black"
    title="Contact us"
    lead="Questions about events, membership or partnerships. We answer within a few days during the semester."
    image={sunset}
    imageAlt="Power line towers silhouetted against an orange sunset"
  />

  <section class="section" aria-labelledby="form-title">
    <div class="wrap contact">
      <div class="details">
        <h2 class="t-headline" data-reveal>Write to us</h2>
        <a href={`mailto:${site.email}`} class="email" data-reveal style="--i: 1">{site.email}</a>

        <h3 class="t-title mt-12" data-reveal style="--i: 2">Follow the chapter</h3>
        <ul role="list" class="mt-4 flex flex-col gap-1" data-reveal style="--i: 2">
          {
            social.map((s) => (
              <li>
                <a href={s.href} class="link inline-flex min-h-11 items-center gap-2" rel="me noopener">
                  {s.label} <Arrow size={16} direction="up-right" />
                </a>
              </li>
            ))
          }
        </ul>

        <h3 class="t-title mt-12" data-reveal style="--i: 3">Find us</h3>
        <address class="mt-4 not-italic" data-reveal style="--i: 3">{site.address}</address>
      </div>

      <form class="form field-surface" action={formAction} method="POST" data-contact-form data-reveal style="--i: 1">
        <h2 id="form-title" class="t-title">Send a message</h2>

        <div class="field-row">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field-row">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            spellcheck="false"
            placeholder="you@university.edu…"
            required
          />
        </div>
        <div class="field-row">
          <label for="topic">Topic</label>
          <select id="topic" name="topic">
            <option>Events</option>
            <option>Membership</option>
            <option>Partnership or sponsoring</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field-row">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <!-- Spam trap for bots; Formspree ignores submissions that fill it. -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <button type="submit" class="btn mt-2 self-start" data-submit>
          Send message <Arrow size={18} />
        </button>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </form>
    </div>
  </section>

  <section aria-labelledby="map-title" class="map-band">
    <h2 id="map-title" class="sr-only">Map</h2>
    <iframe
      src={mapSrc}
      title={`Map showing ${site.university}, ${site.city}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="map"></iframe>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 56px 24px;
    align-items: start;
  }
  .details { grid-column: 1 / span 5; }
  .form { grid-column: 7 / span 6; }
  .email {
    display: inline-block;
    margin-top: 24px;
    font-size: clamp(19px, 1.6vw, 24px);
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }
  .email:hover { text-decoration-color: transparent; }

  .form { display: flex; flex-direction: column; gap: 24px; padding: clamp(24px, 3vw, 40px); border-radius: var(--radius); }
  .field-row { display: flex; flex-direction: column; gap: 8px; }
  .field-row label { font-weight: 500; }
  .form input,
  .form select,
  .form textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    border: 0;
    border-bottom: 2px solid var(--ink-muted);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: var(--canvas);
    color: var(--ink);
    font: inherit;
  }
  .form textarea { resize: vertical; }
  .form input:focus-visible,
  .form select:focus-visible,
  .form textarea:focus-visible { border-bottom-color: var(--focus); }
  .form input::placeholder { color: var(--ink-muted); }
  .status { min-height: 1.5em; font-weight: 500; }
  .status[data-state='error'] { color: #da1e28; }
  :global([data-theme='dark']) .status[data-state='error'] { color: #ff8389; }

  .map-band { background: var(--surface-1); }
  .map { display: block; width: 100%; height: min(60vh, 520px); border: 0; }

  @media (max-width: 899px) {
    .contact { display: flex; flex-direction: column; align-items: stretch; }
  }
</style>

<script>
  import { site } from '../config/site';
import sunset from '../assets/found/mood-sunset-lines.jpg';

  // Progressive enhancement: without JavaScript the form posts to Formspree directly.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !submit) return;
    const say = (text: string, state: 'ok' | 'error' | 'busy') => {
      status.textContent = text;
      status.dataset.state = state;
    };

    if (site.formspreeId.startsWith('TODO')) {
      say(`The form is not connected yet. Please email us at ${site.email}.`, 'error');
      return;
    }

    submit.disabled = true;
    say('Sending…', 'busy');
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      say('Thank you. Your message was sent; we will reply by email.', 'ok');
    } catch {
      say(`Sending failed. Check your connection and try again, or email us at ${site.email}.`, 'error');
    } finally {
      submit.disabled = false;
    }
  });
</script>
