---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { url } from '../lib/utils';

const links = [
  { href: '/', label: 'Home' },
  { href: '/events/', label: 'Events' },
  { href: '/news/', label: 'News' },
  { href: '/contact/', label: 'Contact' },
];
---
<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="notfound field-black field" aria-labelledby="nf-title">
    <div class="wrap nf-head">
      <h1 id="nf-title" class="t-display-lg max-w-[14ch]" data-reveal>This folder is empty</h1>
      <p class="mt-8 max-w-[44ch] text-[20px]" data-reveal style="--i: 1">
        Error 404: the page you were looking for has moved or never existed. Try one of these instead.
      </p>
    </div>

    <nav class="nf-folders" aria-label="Suggested pages">
      {
        links.map((l, i) => (
          <a href={url(l.href)} class={`nf-folder ${['field-pes', 'field-ies', 'field-ias', 'field-blue'][i]}`} style={`--n: ${i}`}>
            <span class="nf-tab tab-shape" aria-hidden="true" />
            <span class="nf-strip">
              {l.label} <Arrow size={20} />
            </span>
          </a>
        ))
      }
    </nav>
  </section>
</BaseLayout>

<style>
  .notfound { padding-bottom: 0; }
  .nf-head { padding-top: clamp(64px, 10vw, 128px); padding-bottom: 72px; }
  .nf-folders { display: flex; flex-direction: column; padding-top: 32px; }
  .nf-folder {
    position: relative;
    display: block;
    text-decoration: none;
    transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
    animation: nf-rise 720ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(200ms + var(--n) * 90ms);
  }
  @keyframes nf-rise { from { transform: translateY(40px); } }
  .nf-folder:hover, .nf-folder:focus-visible { transform: translateY(-8px); }
  .nf-folder:focus-visible { outline-offset: -3px; }
  .nf-tab {
    position: absolute;
    bottom: 100%;
    left: calc(var(--gutter) + var(--n) * 22%);
    width: 140px;
    height: 28px;
    background: inherit;
  }
  .nf-strip {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 72px;
    padding: 0 var(--gutter);
    font-size: clamp(22px, 2.1vw, 30px);
  }
  @media (max-width: 639px) {
    .nf-tab { width: 96px; left: calc(var(--gutter) + var(--n) * 18%); }
  }
</style>
