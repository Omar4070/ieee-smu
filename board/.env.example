# Copy this file to .env and fill it in to connect the app to Supabase.
# Without these two values the app runs as a demo on sample data.
# Supabase → Project settings → API (or "API keys"): the project URL and the anon / publishable key.
# The anon key is meant to be public: what each person may read or change is enforced by the
# access rules in supabase/schema.sql, not by keeping this key secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

